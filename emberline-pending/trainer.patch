@@ -69,6 +73,35 @@ const SAFETY = ["HARM_CATEGORY_HARASSMENT", "HARM_CATEGORY_HATE_SPEECH", "HARM_C
 
 const clip = (v: unknown, n: number) => String(v ?? "").slice(0, n).trim();
 
